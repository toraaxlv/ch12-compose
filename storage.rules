rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Autentikasi bukan otorisasi: uid di path harus sama dengan pemilik token.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Berkas yang diterima: JPEG dan < 1 MB. Batas ini yang mencegah
    // seseorang memakai bucket sebagai tempat penyimpanan gratis.
    function isValidPhoto() {
      return request.resource.size < 1 * 1024 * 1024
          && request.resource.contentType == 'image/jpeg';
    }

    match /users/{userId}/profile.jpg {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidPhoto();
    }
  }
}
